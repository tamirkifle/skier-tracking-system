# Copy to .env and adjust. Every value below has a working default in
# application.properties, so an empty .env still runs against `make up`.

# --- Broker -----------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Cache ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AWS --------------------------------------------------------------------
# No real AWS credentials belong in this file. Both services resolve credentials
# through the SDK default provider chain:
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN (env)
#   2. ~/.aws/credentials profile named by AWS_PROFILE
#   3. container credentials (ECS task role)
#   4. EC2 instance profile
# Prefer 2 locally and 4 in deployment.
AWS_REGION=us-west-2
# Point at LocalStack for local runs; leave empty to use the real service.
AWS_DYNAMODB_ENDPOINT=http://localhost:4566
# LocalStack ignores credential values but the SDK still requires them to be present.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Server tuning ----------------------------------------------------------
SERVER_PORT=8080
TRACING_SAMPLE_RATE=0.01

# --- Consumer tuning --------------------------------------------------------
CONSUMER_CONCURRENCY=32
CONSUMER_PREFETCH=250
WRITER_MODE=batch
WRITER_BATCH_SIZE=25
WRITER_LINGER_MS=20
WRITER_THREADS=16
CARDINALITY_STRATEGY=dynamodb
